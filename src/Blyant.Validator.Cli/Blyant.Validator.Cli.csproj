<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>blyant-validator</AssemblyName>
    <RootNamespace>Blyant.Validator.Cli</RootNamespace>
    <!-- Single-file publishing; see "Building" in README.md for the publish command. -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- The icon of blyant-validator.exe (Windows): a checkmark in the style of Blyant's icon, 16 to 256 pixels.
         It is drawn by tools/icon.py -->
    <ApplicationIcon>BlyantValidator.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blyant.Validator.Core\Blyant.Validator.Core.csproj" />
    <ProjectReference Include="..\Blyant.Validator.Html\Blyant.Validator.Html.csproj" />
    <ProjectReference Include="..\Blyant.Validator.Css\Blyant.Validator.Css.csproj" />
    <ProjectReference Include="..\Blyant.Validator.Vnu\Blyant.Validator.Vnu.csproj" />
    <ProjectReference Include="..\Blyant.Validator.Xml\Blyant.Validator.Xml.csproj" />
    <ProjectReference Include="..\Blyant.Validator.Markdown\Blyant.Validator.Markdown.csproj" />
    <ProjectReference Include="..\Blyant.Validator.Typst\Blyant.Validator.Typst.csproj" />
    <ProjectReference Include="..\Blyant.Validator.TypstCompiler\Blyant.Validator.TypstCompiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Blyant.Validator.Tests" />
  </ItemGroup>

</Project>
